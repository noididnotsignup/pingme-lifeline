# -------------------------------------------------------------
# PingME Lifeline — Environment Variables Reference
# Team The Callback (Safety & Emergency Identity Platform)
# -------------------------------------------------------------

# 1. Supabase Project Configuration (Required for Live Cross-Device DB & Realtime)
# Found in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 2. Supabase Service Role Key (Server-side API routes & Admin overrides)
# WARNING: Keep secret! Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. Canonical Application Base URL (For QR code links and absolute redirects)
# In production on Vercel: set to https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Official Hospital / Paramedic Authorization Passkey
# Replaces hardcoded client passcodes with server-validated authorization.
# Default in demo/development: HOSP-1234
OFFICIAL_PASSKEY=HOSP-1234
